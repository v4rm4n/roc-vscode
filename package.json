{
  "name": "roc-community",
  "displayName": "Roc Community",
  "description": "Unofficial, community-maintained VS Code support for the Roc programming language, including support for Roc compiler nightlies.",
  "version": "0.0.5",
  "publisher": "v4rm4n",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./extension.js",
  "icon": "images/icon.png",
  "contributes": {
    "languages": [
      {
        "id": "roc",
        "aliases": [
          "Roc",
          "roc"
        ],
        "extensions": [
          ".roc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "roc",
        "scopeName": "source.roc",
        "path": "./syntaxes/roc.tmLanguage.json"
      },
      {
        "scopeName": "markdown.roc.codeblock",
        "path": "./syntaxes/roc.codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.roc": "roc"
        }
      }
    ],
    "configuration": {
      "title": "Roc",
      "properties": {
        "roc.path": {
          "type": "string",
          "default": "roc",
          "description": "Path to the roc binary (a new-compiler nightly). Leave as `roc` if it is on your PATH."
        }
      }
    },
    "commands": [
      {
        "command": "roc.restartServer",
        "title": "Roc: Restart Language Server"
      },
      {
        "command": "roc.toggleTypeHints",
        "title": "Roc: Toggle Type Hints"
      }
    ],
    "keybindings": [
      {
        "command": "roc.toggleTypeHints",
        "key": "ctrl+k h",
        "mac": "cmd+k h",
        "when": "editorLangId == roc"
      }
    ],
    "configurationDefaults": {
      "[roc]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.formatOnSave": true
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
